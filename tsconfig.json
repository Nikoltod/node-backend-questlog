{
  "compilerOptions": {
     "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "allowImportingTsExtensions": true,
    "noEmit": true,
     "types": ["node"],

    "paths": {
      "labs/*": ["./labs/*"]
    },
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "labs/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}